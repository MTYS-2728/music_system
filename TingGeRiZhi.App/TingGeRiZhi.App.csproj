<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>聆迹</AssemblyName>
    <RootNamespace>TingGeRiZhi.App</RootNamespace>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <EnableDefaultWindowsTargeting>true</EnableDefaultWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <Version>2.1.0</Version>
    <AssemblyTitle>聆迹 · 听歌日志</AssemblyTitle>
    <Product>聆迹</Product>
    <Company>聆迹</Company>
    <SatelliteResourceLanguages>zh-Hans;en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <!-- UseWindowsForms 会引入 WinForms 的隐式 using，和 WPF 类型重名；这里移除，
         托盘相关代码改用 Forms 别名显式引用。 -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TingGeRiZhi.Core\TingGeRiZhi.Core.csproj" />
  </ItemGroup>

</Project>
