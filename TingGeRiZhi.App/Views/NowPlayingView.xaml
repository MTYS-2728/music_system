<UserControl x:Class="TingGeRiZhi.App.Views.NowPlayingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:TingGeRiZhi.App.ViewModels">
    <ScrollViewer x:Name="PageScroll" VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
        <StackPanel>

            <!-- ============================ 主卡片 -->
            <Border Style="{StaticResource Card}" Padding="26,24">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- 封面 -->
                    <Border Width="152" Height="152" CornerRadius="18" Background="{DynamicResource B.CoverPlaceholder}"
                            ClipToBounds="True" VerticalAlignment="Top">
                        <Grid>
                            <Path Data="{StaticResource G.Music}" Stroke="{DynamicResource B.CoverGlyph}" StrokeThickness="1.6"
                                  Width="56" Height="56" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Image x:Name="CoverImage" Stretch="UniformToFill" Visibility="Collapsed" />
                        </Grid>
                    </Border>

                    <!-- 信息 -->
                    <StackPanel Grid.Column="1" Margin="26,0,24,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Border x:Name="StateChip" Style="{StaticResource Chip}" Background="{DynamicResource B.SurfaceAlt}">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse x:Name="StateDot" Width="7" Height="7" Fill="{DynamicResource B.StatusIdle}" Margin="0,0,7,0" VerticalAlignment="Center" />
                                    <TextBlock x:Name="StateText" Text="等待媒体会话" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{DynamicResource B.TextMuted}" />
                                </StackPanel>
                            </Border>
                            <Border x:Name="AutoChip" Style="{StaticResource Chip}" Margin="8,0,0,0">
                                <TextBlock x:Name="AutoText" FontSize="12" Foreground="{DynamicResource B.TextMuted}" Text="自动记录" />
                            </Border>
                        </StackPanel>

                        <TextBlock x:Name="TitleText" Text="尚未读取到正在播放的歌曲" FontSize="25" FontWeight="Bold"
                                   TextTrimming="CharacterEllipsis" Margin="0,14,0,0" />
                        <TextBlock x:Name="ArtistText" Text="在 QQ 音乐或网易云音乐里播放，或使用右侧按钮手动记录"
                                   FontSize="14" Foreground="{DynamicResource B.TextMuted}" Margin="0,7,0,0"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="AlbumText" Foreground="{DynamicResource B.TextFaint}" FontSize="12.5"
                                   Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />

                        <Grid Margin="0,20,0,0">
                            <ProgressBar x:Name="Progress" Maximum="1" Value="0" Height="6" />
                        </Grid>
                        <Grid Margin="0,8,0,0">
                            <TextBlock x:Name="PositionText" Text="--:--" Foreground="{DynamicResource B.TextFaint}" FontSize="12" />
                            <TextBlock x:Name="DurationText" Text="--:--" Foreground="{DynamicResource B.TextFaint}" FontSize="12"
                                       HorizontalAlignment="Right" />
                        </Grid>

                        <TextBlock x:Name="CountdownText" Margin="0,14,0,0" FontSize="12.5"
                                   Foreground="{DynamicResource B.AccentSoftText}" />
                    </StackPanel>

                    <!-- 操作 -->
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Width="186">
                        <!-- 均衡器 -->
                        <Border x:Name="EqualizerBox" Background="{DynamicResource B.AccentSoft}" CornerRadius="10"
                                Height="52" Margin="0,0,0,14" Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Rectangle x:Name="EqBar1" Width="5" Height="12" RadiusX="2.5" RadiusY="2.5" Fill="{DynamicResource B.Accent}" Margin="0,0,5,0" VerticalAlignment="Bottom" />
                                <Rectangle x:Name="EqBar2" Width="5" Height="24" RadiusX="2.5" RadiusY="2.5" Fill="{DynamicResource B.Accent}" Margin="0,0,5,0" VerticalAlignment="Bottom" />
                                <Rectangle x:Name="EqBar3" Width="5" Height="17" RadiusX="2.5" RadiusY="2.5" Fill="{DynamicResource B.Accent}" Margin="0,0,5,0" VerticalAlignment="Bottom" />
                                <Rectangle x:Name="EqBar4" Width="5" Height="30" RadiusX="2.5" RadiusY="2.5" Fill="{DynamicResource B.Accent}" VerticalAlignment="Bottom" />
                            </StackPanel>
                        </Border>

                        <Button x:Name="RecordNowButton" Style="{StaticResource BtnPrimary}" Content="记录当前歌曲"
                                HorizontalAlignment="Stretch" Click="RecordNow_Click" />
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" x:Name="FavoriteButton" Content="收藏" Margin="0,0,4,0"
                                    HorizontalAlignment="Stretch" Click="Favorite_Click" />
                            <Button Grid.Column="1" x:Name="NotesButton" Content="备注" Margin="4,0,0,0"
                                    HorizontalAlignment="Stretch" Click="Notes_Click" />
                        </Grid>
                        <Button x:Name="EditButton" Content="编辑歌曲信息" Margin="0,8,0,0" HorizontalAlignment="Stretch"
                                Click="Edit_Click" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ============================ 概览 -->
            <Grid Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Card}" Padding="18,15" Margin="0,0,7,0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource T.Label}" Text="今日播放" />
                        <TextBlock x:Name="TodayCount" Text="0" FontSize="26" FontWeight="Bold" Margin="0,6,0,0" />
                        <TextBlock x:Name="TodayCaption" Style="{StaticResource T.Faint}" Text="还没有今天的记录" Margin="0,3,0,0" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource Card}" Padding="18,15" Margin="7,0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource T.Label}" Text="近 7 天" />
                        <TextBlock x:Name="WeekCount" Text="0" FontSize="26" FontWeight="Bold" Margin="0,6,0,0" />
                        <TextBlock x:Name="WeekCaption" Style="{StaticResource T.Faint}" Text="—" Margin="0,3,0,0" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource Card}" Padding="18,15" Margin="7,0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource T.Label}" Text="曲库" />
                        <TextBlock x:Name="SongCount" Text="0" FontSize="26" FontWeight="Bold" Margin="0,6,0,0" />
                        <TextBlock x:Name="SongCaption" Style="{StaticResource T.Faint}" Text="首歌曲" Margin="0,3,0,0" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="3" Style="{StaticResource Card}" Padding="18,15" Margin="7,0,0,0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource T.Label}" Text="累计收听" />
                        <TextBlock x:Name="TotalTime" Text="0 分钟" FontSize="22" FontWeight="Bold" Margin="0,7,0,0" />
                        <TextBlock x:Name="TotalCaption" Style="{StaticResource T.Faint}" Text="共 0 次播放" Margin="0,3,0,0" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ============================ 最近记录 -->
            <Border Style="{StaticResource Card}" Margin="0,18,0,0" Padding="20,16">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <TextBlock Style="{StaticResource T.Section}" Text="最近记录" />
                        <Button Content="查看全部" Style="{StaticResource BtnGhost}" HorizontalAlignment="Right"
                                Padding="8,3" MinHeight="26" Click="GoRecords_Click" />
                    </Grid>
                    <ItemsControl x:Name="RecentList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:RecordRow}">
                                <Grid Height="52">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="38" Height="38" CornerRadius="9" Background="{DynamicResource B.CoverPlaceholder}"
                                            ClipToBounds="True" VerticalAlignment="Center">
                                        <Grid>
                                            <Path Data="{StaticResource G.Music}" Stroke="{DynamicResource B.CoverGlyph}"
                                                  StrokeThickness="1.6" Width="16" Height="16" Stretch="Uniform"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            <Image Stretch="UniformToFill" Source="{Binding CoverPath, Converter={StaticResource CoverImage}, ConverterParameter=76}" />
                                        </Grid>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding ArtistAlbum}" Style="{StaticResource T.Faint}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="12,0,0,0">
                                        <TextBlock Text="{Binding LocalTimeOnly}" Foreground="{DynamicResource B.TextMuted}" FontSize="12.5" HorizontalAlignment="Right" />
                                        <TextBlock Text="{Binding LocalDate}" Style="{StaticResource T.Faint}" HorizontalAlignment="Right" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <Border Grid.Column="3" Style="{StaticResource Chip}" Margin="14,0,0,0" VerticalAlignment="Center" Padding="9,3">
                                        <TextBlock Text="{Binding GroupCount, StringFormat=×{0}}" FontSize="11.5"
                                                   Foreground="{DynamicResource B.TextMuted}" />
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="RecentEmpty" Text="还没有播放记录。播放一首歌，或点击「记录当前歌曲」开始。"
                               Style="{StaticResource T.Faint}" Margin="2,10,0,6" Visibility="Collapsed" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
