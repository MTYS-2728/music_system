<UserControl x:Class="TingGeRiZhi.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
        <StackPanel>

            <TextBlock Text="设置" Style="{StaticResource T.Title}" />
            <TextBlock Text="所有设置都保存在本地，不会上传到任何服务器。" Style="{StaticResource T.Muted}" Margin="0,5,0,16" />

            <!-- ================================ 记录 -->
            <Border Style="{StaticResource Card}" Padding="22,18">
                <StackPanel>
                    <TextBlock Text="记录方式" Style="{StaticResource T.Section}" />
                    <TextBlock Text="聆迹只通过 Windows 原生媒体会话读取播放信息，不会下载或破解任何音频。" Style="{StaticResource T.Faint}" Margin="0,5,0,14" />

                    <CheckBox x:Name="AutoRecordSwitch" Style="{StaticResource Switch}" Content="启动后自动记录"
                              Click="Setting_Changed" />

                    <Grid Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Text="连续播放多久后记为一次播放" FontSize="13" />
                            <TextBlock Text="少于该时长的跳过不会被记录，避免误触产生垃圾数据。" Style="{StaticResource T.Faint}" Margin="0,3,0,0" />
                        </StackPanel>
                        <ComboBox x:Name="ThresholdBox" Width="140" HorizontalAlignment="Right" VerticalAlignment="Center"
                                  SelectionChanged="Setting_Changed" />
                    </Grid>

                    <Grid Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Text="读取间隔" FontSize="13" />
                            <TextBlock Text="间隔越短越灵敏，占用的资源也略多。" Style="{StaticResource T.Faint}" Margin="0,3,0,0" />
                        </StackPanel>
                        <ComboBox x:Name="PollBox" Width="140" HorizontalAlignment="Right" VerticalAlignment="Center"
                                  SelectionChanged="Setting_Changed" />
                    </Grid>

                    <Grid Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Text="自动抓取封面" FontSize="13" />
                            <TextBlock Text="从媒体会话读取专辑缩略图并缓存到本地，抓不到时保留占位图。" Style="{StaticResource T.Faint}" Margin="0,3,0,0" />
                        </StackPanel>
                        <CheckBox x:Name="CoverSwitch" Style="{StaticResource Switch}" HorizontalAlignment="Right"
                                  VerticalAlignment="Center" Click="Setting_Changed" />
                    </Grid>

                    <Separator Margin="0,16,0,4" />

                    <Grid Margin="0,8,0,0">
                        <StackPanel>
                            <TextBlock Text="只记录 QQ 音乐" FontSize="13" FontWeight="SemiBold" />
                            <TextBlock x:Name="QqOnlyHint" Style="{StaticResource T.Faint}" Margin="0,3,0,0" TextWrapping="Wrap"
                                       Text="开启后只记录来自 QQ 音乐的媒体会话；浏览器、B 站等其它应用一律跳过。" />
                        </StackPanel>
                        <CheckBox x:Name="QqOnlySwitch" Style="{StaticResource Switch}" HorizontalAlignment="Right"
                                  VerticalAlignment="Center" Click="Setting_Changed" />
                    </Grid>

                    <Border Background="{DynamicResource B.SurfaceAlt}" BorderBrush="{DynamicResource B.Border}"
                            BorderThickness="1" CornerRadius="{DynamicResource R.Control}" Padding="14,11" Margin="0,12,0,0">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="检测到的媒体会话" Style="{StaticResource T.Label}" VerticalAlignment="Center" />
                                <Button Content="刷新检测" Style="{StaticResource BtnGhost}" HorizontalAlignment="Right"
                                        Padding="8,3" MinHeight="24" FontSize="12" Click="RefreshSessions_Click" />
                            </Grid>
                            <ItemsControl x:Name="SessionList" Margin="0,6,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Style="{StaticResource Chip}" Padding="8,2" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding KindLabel}" FontSize="11.5"
                                                           Foreground="{DynamicResource B.TextMuted}" />
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="10,0,10,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding FriendlySource}" FontSize="12.5" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Display}" Style="{StaticResource T.Faint}"
                                                           TextTrimming="CharacterEllipsis" MaxWidth="420" Margin="0,2,0,0" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{Binding StateLabel}" Style="{StaticResource T.Faint}"
                                                       VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock x:Name="SessionEmptyText" Text="当前没有活动的媒体会话。"
                                       Style="{StaticResource T.Faint}" Margin="0,6,0,2" Visibility="Collapsed" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- ================================ 外观 -->
            <Border Style="{StaticResource Card}" Padding="22,18" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="外观" Style="{StaticResource T.Section}" />

                    <Grid Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Text="主题" FontSize="13" />
                            <TextBlock Text="深色主题适合夜间长时间使用。" Style="{StaticResource T.Faint}" Margin="0,3,0,0" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <ToggleButton x:Name="ThemeLight" Style="{StaticResource ChipToggle}" Content="浅色" Click="Theme_Click" />
                            <ToggleButton x:Name="ThemeDark" Style="{StaticResource ChipToggle}" Content="深色" Margin="6,0,0,0" Click="Theme_Click" />
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Text="列表每页条数" FontSize="13" />
                            <TextBlock Text="听歌记录页每页显示多少首歌。" Style="{StaticResource T.Faint}" Margin="0,3,0,0" />
                        </StackPanel>
                        <ComboBox x:Name="PageSizeBox" Width="140" HorizontalAlignment="Right" VerticalAlignment="Center"
                                  SelectionChanged="Setting_Changed" />
                    </Grid>

                    <Grid Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Text="删除前确认" FontSize="13" />
                            <TextBlock Text="删除播放记录时弹出确认框。" Style="{StaticResource T.Faint}" Margin="0,3,0,0" />
                        </StackPanel>
                        <CheckBox x:Name="ConfirmSwitch" Style="{StaticResource Switch}" HorizontalAlignment="Right"
                                  VerticalAlignment="Center" Click="Setting_Changed" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ================================ 托盘 -->
            <Border Style="{StaticResource Card}" Padding="22,18" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="窗口与启动" Style="{StaticResource T.Section}" />

                    <Grid Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Text="关闭窗口时最小化到托盘" FontSize="13" />
                            <TextBlock Text="关闭后自动记录仍在托盘后台运行。" Style="{StaticResource T.Faint}" Margin="0,3,0,0" />
                        </StackPanel>
                        <CheckBox x:Name="TraySwitch" Style="{StaticResource Switch}" HorizontalAlignment="Right"
                                  VerticalAlignment="Center" Click="Setting_Changed" />
                    </Grid>

                    <Grid Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Text="启动时直接最小化到托盘" FontSize="13" />
                            <TextBlock Text="开机自启动时更安静。" Style="{StaticResource T.Faint}" Margin="0,3,0,0" />
                        </StackPanel>
                        <CheckBox x:Name="StartMinSwitch" Style="{StaticResource Switch}" HorizontalAlignment="Right"
                                  VerticalAlignment="Center" Click="Setting_Changed" />
                    </Grid>

                    <Grid Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Text="开机自动启动" FontSize="13" />
                            <TextBlock Text="写入当前用户的启动项，可随时关闭。" Style="{StaticResource T.Faint}" Margin="0,3,0,0" />
                        </StackPanel>
                        <CheckBox x:Name="StartupSwitch" Style="{StaticResource Switch}" HorizontalAlignment="Right"
                                  VerticalAlignment="Center" Click="Startup_Click" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ================================ 数据 -->
            <Border Style="{StaticResource Card}" Padding="22,18" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="数据管理" Style="{StaticResource T.Section}" />

                    <Border Background="{DynamicResource B.SurfaceAlt}" BorderBrush="{DynamicResource B.Border}"
                            BorderThickness="1" CornerRadius="{DynamicResource R.Control}" Padding="14,11" Margin="0,14,0,0">
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="数据库位置" Style="{StaticResource T.Label}" />
                                <TextBlock x:Name="DbPathText" FontSize="12.5" TextWrapping="Wrap" Margin="0,5,0,0" />
                                <TextBlock x:Name="DbInfoText" Style="{StaticResource T.Faint}" Margin="0,6,0,0" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button Content="复制路径" Click="CopyPath_Click" Margin="0,0,8,0" />
                                <Button Content="打开目录" Click="OpenFolder_Click" Margin="0" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <WrapPanel Margin="0,14,0,0">
                        <Button Content="导出全部 CSV" Click="ExportAllCsv_Click" Margin="0,0,8,8" />
                        <Button Content="导出全部 JSON" Click="ExportAllJson_Click" Margin="0,0,8,8" />
                        <Button Content="导入记录" Click="Import_Click" Margin="0,0,8,8" />
                        <Button Content="备份数据库" Click="Backup_Click" Margin="0,0,8,8" />
                        <Button Content="恢复数据库" Click="Restore_Click" Margin="0,0,8,8" />
                        <Button Content="清理未使用的封面" Click="CleanupCovers_Click" Margin="0,0,8,8" />
                    </WrapPanel>

                    <Separator Margin="0,6,0,12" />

                    <Grid>
                        <StackPanel>
                            <TextBlock Text="清空全部数据" FontSize="13" Foreground="{DynamicResource B.Danger}" />
                            <TextBlock Text="删除所有播放记录；可以选择同时删除歌曲资料、备注与收藏。" Style="{StaticResource T.Faint}" Margin="0,3,0,0" />
                        </StackPanel>
                        <Button Content="清空数据" Style="{StaticResource BtnDanger}" HorizontalAlignment="Right"
                                VerticalAlignment="Center" Click="ClearAll_Click" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ================================ 关于 -->
            <Border Style="{StaticResource Card}" Padding="22,18" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="关于聆迹" Style="{StaticResource T.Section}" />
                    <TextBlock Margin="0,10,0,0" TextWrapping="Wrap" LineHeight="21" Foreground="{DynamicResource B.TextMuted}"
                               Text="聆迹是一个本地优先的 Windows 听歌日志。它通过 Windows 原生媒体会话读取当前播放的歌曲、歌手、专辑与进度，不下载、不缓存、不破解任何歌曲音频，也不调用任何非官方的音乐接口。" />
                    <TextBlock x:Name="VersionText" Style="{StaticResource T.Faint}" Margin="0,12,0,0" />
                    <TextBlock x:Name="StatusHintText" Foreground="{DynamicResource B.AccentSoftText}" FontSize="12.5"
                               Margin="0,8,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
