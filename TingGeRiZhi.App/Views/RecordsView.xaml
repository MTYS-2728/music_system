<UserControl x:Class="TingGeRiZhi.App.Views.RecordsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:TingGeRiZhi.App.ViewModels">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ==================================================== 工具条 -->
        <Border Grid.Row="0" Style="{StaticResource Card}" Padding="16,14" Margin="0,0,0,14">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0" Width="268">
                        <TextBox x:Name="SearchBox" Padding="34,7,30,7" Tag="搜索歌曲、歌手或专辑…"
                                 TextChanged="Filter_Changed" />
                        <Path Data="{StaticResource G.Search}" Stroke="{DynamicResource B.TextFaint}" StrokeThickness="1.6"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="15" Height="15" Stretch="Uniform"
                              HorizontalAlignment="Left" VerticalAlignment="Center" Margin="12,0,0,0" IsHitTestVisible="False" />
                        <Button x:Name="ClearSearchButton" Content="✕" Style="{StaticResource BtnGhost}"
                                HorizontalAlignment="Right" VerticalAlignment="Center" Padding="6,2" MinHeight="22"
                                FontSize="11" Margin="0,0,4,0" Click="ClearSearch_Click" Visibility="Collapsed" />
                    </Grid>

                    <ToggleButton Grid.Column="1" x:Name="FavoriteFilter" Style="{StaticResource ChipToggle}"
                                  Margin="8,0,0,0" VerticalAlignment="Center" Click="Filter_Changed">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource G.Star}" Width="13" Height="13" Stretch="Uniform"
                                  Fill="{DynamicResource B.Star}" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="只看收藏" FontSize="12.5" />
                        </StackPanel>
                    </ToggleButton>

                    <TextBlock Grid.Column="2" x:Name="SummaryText" Style="{StaticResource T.Muted}"
                               VerticalAlignment="Center" Margin="16,0,0,0" TextTrimming="CharacterEllipsis" />

                    <ComboBox Grid.Column="3" x:Name="SortBox" Width="156" Margin="8,0,8,0"
                              SelectionChanged="Sort_Changed" ToolTip="排序方式" />
                    <ComboBox Grid.Column="4" x:Name="PageSizeBox" Width="124"
                              SelectionChanged="PageSize_Changed" ToolTip="每页条数" />
                </Grid>

                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <ToggleButton x:Name="RangeAll" Style="{StaticResource ChipToggle}" Content="全部" Click="Range_Click" />
                        <ToggleButton x:Name="RangeToday" Style="{StaticResource ChipToggle}" Content="今天" Click="Range_Click" />
                        <ToggleButton x:Name="Range7" Style="{StaticResource ChipToggle}" Content="近 7 天" Click="Range_Click" />
                        <ToggleButton x:Name="Range30" Style="{StaticResource ChipToggle}" Content="近 30 天" Click="Range_Click" />
                        <ToggleButton x:Name="RangeMonth" Style="{StaticResource ChipToggle}" Content="本月" Click="Range_Click" />
                        <ToggleButton x:Name="RangeCustom" Style="{StaticResource ChipToggle}" Content="自定义" Click="Range_Click" />

                        <StackPanel x:Name="CustomRangePanel" Orientation="Horizontal" Margin="6,0,0,0" Visibility="Collapsed">
                            <DatePicker x:Name="FromDate" Width="128" SelectedDateChanged="Filter_Changed" ToolTip="起始日期（含）" />
                            <TextBlock Text="—" Margin="8,0" VerticalAlignment="Center" Foreground="{DynamicResource B.TextFaint}" />
                            <DatePicker x:Name="ToDate" Width="128" SelectedDateChanged="Filter_Changed" ToolTip="结束日期（含）" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button x:Name="ManualAddButton" Content="手动添加" Click="ManualAdd_Click" Margin="0,0,8,0" />
                        <Button x:Name="BatchAddButton" Content="批量添加" Click="BatchAdd_Click" Margin="0,0,8,0" />
                        <Button x:Name="RecordNowButton" Content="记录当前歌曲" Style="{StaticResource BtnPrimary}"
                                Click="RecordNow_Click" Margin="0" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- ==================================================== 列表 -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0" ClipToBounds="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- 列表头 -->
                <Grid Grid.Row="0" Margin="18,13,14,11">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="听歌记录" Style="{StaticResource T.Section}" />
                        <Border Style="{StaticResource Chip}" Margin="10,0,0,0" Padding="8,2">
                            <TextBlock x:Name="TotalBadge" Text="0" FontSize="11.5" Foreground="{DynamicResource B.TextMuted}" />
                        </Border>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="ExportCsvButton" Style="{StaticResource BtnGhost}" Click="ExportCsv_Click"
                                ToolTip="把当前筛选结果导出为 CSV" Padding="9,4">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource G.Export}" Stroke="{DynamicResource B.TextMuted}" StrokeThickness="1.5"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="14" Height="14" Stretch="Uniform"
                                      VerticalAlignment="Center" />
                                <TextBlock Text="CSV" Margin="6,0,0,0" FontSize="12.5" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="ExportJsonButton" Style="{StaticResource BtnGhost}" Click="ExportJson_Click"
                                ToolTip="把当前筛选结果导出为 JSON" Padding="9,4">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource G.Export}" Stroke="{DynamicResource B.TextMuted}" StrokeThickness="1.5"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="14" Height="14" Stretch="Uniform"
                                      VerticalAlignment="Center" />
                                <TextBlock Text="JSON" Margin="6,0,0,0" FontSize="12.5" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="ImportButton" Style="{StaticResource BtnGhost}" Click="Import_Click"
                                ToolTip="从 CSV / JSON 导入播放记录" Padding="9,4">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource G.Import}" Stroke="{DynamicResource B.TextMuted}" StrokeThickness="1.5"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="14" Height="14" Stretch="Uniform"
                                      VerticalAlignment="Center" />
                                <TextBlock Text="导入" Margin="6,0,0,0" FontSize="12.5" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="DeleteSelectedButton" Style="{StaticResource BtnDanger}" Click="DeleteSelected_Click"
                                ToolTip="删除选中的播放记录" Padding="9,4" IsEnabled="False">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource G.Trash}" Stroke="{DynamicResource B.Danger}" StrokeThickness="1.5"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="14" Height="14" Stretch="Uniform"
                                      VerticalAlignment="Center" />
                                <TextBlock Text="删除所选" Margin="6,0,0,0" FontSize="12.5" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <DataGrid Grid.Row="1" x:Name="RecordsGrid" CanUserSortColumns="False" CanUserResizeColumns="True"
                          SelectionChanged="RecordsGrid_SelectionChanged" MouseDoubleClick="RecordsGrid_DoubleClick"
                          RowDetailsVisibilityMode="Collapsed">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="" Width="54">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type vm:RecordRow}">
                                    <Border Width="40" Height="40" CornerRadius="10" Margin="12,0,0,0"
                                            Background="{DynamicResource B.CoverPlaceholder}" ClipToBounds="True">
                                        <Grid>
                                            <Path Data="{StaticResource G.Music}" Stroke="{DynamicResource B.CoverGlyph}"
                                                  StrokeThickness="1.6" Width="16" Height="16" Stretch="Uniform"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            <Image Stretch="UniformToFill"
                                                   Source="{Binding CoverPath, Converter={StaticResource CoverImage}, ConverterParameter=80}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="歌曲" Width="2.2*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type vm:RecordRow}">
                                    <StackPanel Margin="2,0,10,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13.5"
                                                   TextTrimming="CharacterEllipsis" />
                                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                            <TextBlock Text="{Binding Album}" Style="{StaticResource T.Faint}"
                                                       TextTrimming="CharacterEllipsis" MaxWidth="260" />
                                            <TextBlock Text="{Binding SourceLabel}" Style="{StaticResource T.Faint}" Margin="8,0,0,0" />
                                            <TextBlock Text="有备注" Foreground="{DynamicResource B.AccentSoftText}" FontSize="11.5"
                                                       Margin="8,0,0,0"
                                                       Visibility="{Binding HasNotes, Converter={StaticResource BoolToVis}}" />
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="歌手" Binding="{Binding Artist}" Width="1.2*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                    <Setter Property="Margin" Value="2,0,10,0" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTemplateColumn Header="播放时间" Width="140">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type vm:RecordRow}">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding LocalDate}" FontSize="12.5" />
                                        <TextBlock Text="{Binding LocalTimeOnly}" Style="{StaticResource T.Faint}" Margin="0,2,0,0" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="时长" Width="76">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type vm:RecordRow}">
                                    <TextBlock Text="{Binding DurationSeconds, Converter={StaticResource SecondsToText}}"
                                               Foreground="{DynamicResource B.TextMuted}" VerticalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="次数" Width="66">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type vm:RecordRow}">
                                    <Border Style="{StaticResource Chip}" Padding="9,3" HorizontalAlignment="Left"
                                            ToolTip="这首歌历史上被播放的总次数">
                                        <TextBlock Text="{Binding SongPlayCount}" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource B.TextMuted}" />
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="" Width="58">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type vm:RecordRow}">
                                    <Button Style="{StaticResource BtnIcon}" Click="ToggleFavorite_Click" Tag="{Binding}"
                                            ToolTip="收藏 / 取消收藏">
                                        <Path Data="{StaticResource G.Star}" Width="17" Height="17" Stretch="Uniform">
                                            <Path.Style>
                                                <Style TargetType="Path">
                                                    <Setter Property="Fill" Value="Transparent" />
                                                    <Setter Property="Stroke" Value="{DynamicResource B.TextFaint}" />
                                                    <Setter Property="StrokeThickness" Value="1.4" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                                            <Setter Property="Fill" Value="{DynamicResource B.Star}" />
                                                            <Setter Property="Stroke" Value="{DynamicResource B.Star}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Path.Style>
                                        </Path>
                                    </Button>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="" Width="118">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type vm:RecordRow}">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Style="{StaticResource BtnIcon}" Click="Notes_Click" Tag="{Binding}" ToolTip="编辑备注">
                                            <Path Data="{StaticResource G.Note}" Stroke="{DynamicResource B.TextMuted}" StrokeThickness="1.5"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="16" Height="16" Stretch="Uniform" />
                                        </Button>
                                        <Button Style="{StaticResource BtnIcon}" Click="Edit_Click" Tag="{Binding}" ToolTip="编辑歌曲信息">
                                            <Path Data="{StaticResource G.Pencil}" Stroke="{DynamicResource B.TextMuted}" StrokeThickness="1.5"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="15" Height="15" Stretch="Uniform" />
                                        </Button>
                                        <Button Style="{StaticResource BtnIcon}" Click="DeleteRow_Click" Tag="{Binding}" ToolTip="删除这首歌的全部记录">
                                            <Path Data="{StaticResource G.Trash}" Stroke="{DynamicResource B.Danger}" StrokeThickness="1.5"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="15" Height="15" Stretch="Uniform" />
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- 空状态 -->
                <StackPanel x:Name="EmptyState" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center"
                            Visibility="Collapsed" Margin="0,40,0,60">
                    <Border Width="72" Height="72" CornerRadius="22" Background="{DynamicResource B.SurfaceAlt}"
                            HorizontalAlignment="Center">
                        <Path Data="{StaticResource G.List}" Stroke="{DynamicResource B.TextFaint}" StrokeThickness="1.6"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="30" Height="30" Stretch="Uniform"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock x:Name="EmptyTitle" Text="还没有匹配的记录" Style="{StaticResource T.Section}"
                               HorizontalAlignment="Center" Margin="0,16,0,0" />
                    <TextBlock x:Name="EmptyHint" Text="换个关键词或时间范围试试，也可以手动添加一首歌。"
                               Style="{StaticResource T.Faint}" HorizontalAlignment="Center" Margin="0,8,0,0" />
                    <Button x:Name="EmptyClearButton" Content="清除全部筛选" Style="{StaticResource BtnSoft}"
                            HorizontalAlignment="Center" Margin="0,18,0,0" Click="ClearFilters_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ==================================================== 分页 -->
        <Grid Grid.Row="2" Margin="4,14,4,0">
            <TextBlock x:Name="PageSummary" Style="{StaticResource T.Muted}" VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button x:Name="FirstPageButton" Style="{StaticResource BtnGhost}" Content="首页" Click="FirstPage_Click" Padding="9,4" />
                <Button x:Name="PrevPageButton" Style="{StaticResource BtnGhost}" Click="PrevPage_Click" Padding="9,4">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource G.ChevronLeft}" Stroke="{DynamicResource B.TextMuted}" StrokeThickness="1.7"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="12" Height="12" Stretch="Uniform"
                              VerticalAlignment="Center" />
                        <TextBlock Text="上一页" Margin="5,0,0,0" FontSize="12.5" />
                    </StackPanel>
                </Button>
                <TextBlock x:Name="PageText" Style="{StaticResource T.Muted}" VerticalAlignment="Center" Margin="12,0" />
                <Button x:Name="NextPageButton" Style="{StaticResource BtnGhost}" Click="NextPage_Click" Padding="9,4">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="下一页" FontSize="12.5" />
                        <Path Data="{StaticResource G.ChevronRight}" Stroke="{DynamicResource B.TextMuted}" StrokeThickness="1.7"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="12" Height="12" Stretch="Uniform"
                              Margin="5,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button x:Name="LastPageButton" Style="{StaticResource BtnGhost}" Content="末页" Click="LastPage_Click" Padding="9,4" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
