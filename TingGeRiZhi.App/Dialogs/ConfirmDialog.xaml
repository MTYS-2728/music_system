<Window x:Class="TingGeRiZhi.App.Dialogs.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="确认" Width="480" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner">
    <Border Margin="16" Background="{DynamicResource B.Surface}" CornerRadius="{DynamicResource R.Card}"
            BorderBrush="{DynamicResource B.Border}" BorderThickness="1" Effect="{DynamicResource E.Popup}">
        <StackPanel Margin="22,20,22,20">
            <Grid Background="Transparent" MouseLeftButtonDown="Header_MouseDown">
                <StackPanel Orientation="Horizontal">
                    <Border x:Name="IconBox" Width="34" Height="34" CornerRadius="10"
                            Background="{DynamicResource B.DangerSoft}" VerticalAlignment="Center">
                        <TextBlock x:Name="IconText" Text="!" FontSize="18" FontWeight="Bold"
                                   Foreground="{DynamicResource B.Danger}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock x:Name="TitleText" Style="{StaticResource T.Section}" Margin="12,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>

            <TextBlock x:Name="MessageText" Margin="0,14,0,0" TextWrapping="Wrap"
                       Foreground="{DynamicResource B.TextMuted}" LineHeight="20" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button x:Name="CancelButton" Content="取消" IsCancel="True" Click="Cancel_Click" />
                <Button x:Name="OkButton" Content="确定" IsDefault="True" Click="Ok_Click" Margin="8,0,0,0" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
