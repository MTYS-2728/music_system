<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- 聆迹 · 浅色主题令牌。所有键名必须与 Dark.xaml 完全一致。 -->

    <FontFamily x:Key="AppFont">Microsoft YaHei UI, Segoe UI, Arial</FontFamily>
    <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas, Microsoft YaHei UI</FontFamily>

    <!-- 背景层次 -->
    <SolidColorBrush x:Key="B.Window"          Color="#EEF1F6" />
    <SolidColorBrush x:Key="B.Sidebar"         Color="#FFFFFF" />
    <SolidColorBrush x:Key="B.TitleBar"        Color="#FFFFFF" />
    <SolidColorBrush x:Key="B.Surface"         Color="#FFFFFF" />
    <SolidColorBrush x:Key="B.SurfaceAlt"      Color="#F6F8FB" />
    <SolidColorBrush x:Key="B.SurfaceHover"    Color="#EDF3F8" />
    <SolidColorBrush x:Key="B.SurfaceSunken"   Color="#F1F4F9" />

    <!-- 线条 -->
    <SolidColorBrush x:Key="B.Border"          Color="#E2E8F0" />
    <SolidColorBrush x:Key="B.BorderStrong"    Color="#CDD7E3" />
    <SolidColorBrush x:Key="B.Divider"         Color="#EDF1F6" />

    <!-- 文字 -->
    <SolidColorBrush x:Key="B.Text"            Color="#1B2434" />
    <SolidColorBrush x:Key="B.TextMuted"       Color="#63728A" />
    <SolidColorBrush x:Key="B.TextFaint"       Color="#96A3B6" />
    <SolidColorBrush x:Key="B.TextOnAccent"    Color="#FFFFFF" />

    <!-- 主色 -->
    <SolidColorBrush x:Key="B.Accent"          Color="#2C9C8B" />
    <SolidColorBrush x:Key="B.AccentHover"     Color="#24897A" />
    <SolidColorBrush x:Key="B.AccentPressed"   Color="#1E7468" />
    <SolidColorBrush x:Key="B.AccentSoft"      Color="#E3F3F0" />
    <SolidColorBrush x:Key="B.AccentSoftText"  Color="#1F7C6E" />
    <SolidColorBrush x:Key="B.AccentGlow"      Color="#3FB6A2" />

    <!-- 辅助色 -->
    <SolidColorBrush x:Key="B.Indigo"          Color="#5B76E8" />
    <SolidColorBrush x:Key="B.IndigoSoft"      Color="#E9EDFD" />
    <SolidColorBrush x:Key="B.Success"         Color="#1F9D63" />
    <SolidColorBrush x:Key="B.SuccessSoft"     Color="#E3F6EC" />
    <SolidColorBrush x:Key="B.Warning"         Color="#D98A0B" />
    <SolidColorBrush x:Key="B.WarningSoft"     Color="#FDF2DD" />
    <SolidColorBrush x:Key="B.Danger"          Color="#DC4C4C" />
    <SolidColorBrush x:Key="B.DangerSoft"      Color="#FDEAEA" />
    <SolidColorBrush x:Key="B.Star"            Color="#EFAE13" />
    <SolidColorBrush x:Key="B.StarSoft"        Color="#FDF4DC" />

    <!-- 封面色块（无封面时的占位渐变） -->
    <LinearGradientBrush x:Key="B.CoverPlaceholder" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#DCEFEB" Offset="0" />
        <GradientStop Color="#CFE3F5" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="B.HeroGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#E7F4F1" Offset="0" />
        <GradientStop Color="#E8EEFA" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="B.CoverGlyph" Color="#7FB3AB" />

    <!-- 图表 -->
    <SolidColorBrush x:Key="B.ChartBar"        Color="#79C6B8" />
    <SolidColorBrush x:Key="B.ChartBarSoft"    Color="#DCEDE9" />
    <SolidColorBrush x:Key="B.ChartGrid"       Color="#EDF1F6" />

    <!-- 交互 -->
    <SolidColorBrush x:Key="B.Hover"           Color="#E9EFF6" />
    <SolidColorBrush x:Key="B.Pressed"         Color="#DCE5EF" />
    <SolidColorBrush x:Key="B.Selected"        Color="#DCEFEA" />
    <SolidColorBrush x:Key="B.SelectedBorder"  Color="#9FD3C8" />
    <SolidColorBrush x:Key="B.Focus"           Color="#2C9C8B" />
    <SolidColorBrush x:Key="B.ScrollThumb"     Color="#C6D0DD" />
    <SolidColorBrush x:Key="B.ScrollThumbHover" Color="#A9B6C7" />

    <!-- 状态点 -->
    <SolidColorBrush x:Key="B.StatusOnline"    Color="#1F9D63" />
    <SolidColorBrush x:Key="B.StatusIdle"      Color="#96A3B6" />
    <SolidColorBrush x:Key="B.StatusPaused"    Color="#D98A0B" />

    <sys:Double x:Key="D.CardRadius">14</sys:Double>
    <CornerRadius x:Key="R.Card">14</CornerRadius>
    <CornerRadius x:Key="R.Control">9</CornerRadius>
    <CornerRadius x:Key="R.Pill">999</CornerRadius>
    <CornerRadius x:Key="R.Small">7</CornerRadius>

    <DropShadowEffect x:Key="E.Card" BlurRadius="18" ShadowDepth="2" Direction="270" Opacity="0.07" Color="#20303F" />
    <DropShadowEffect x:Key="E.Popup" BlurRadius="24" ShadowDepth="4" Direction="270" Opacity="0.16" Color="#20303F" />
</ResourceDictionary>
